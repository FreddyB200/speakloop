    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "track": {
          "enum": [
            "mic",
            "system"
          ],
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "quote",
        "track"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "FindingCategory": {
      "enum": [
        "grammar",
        "vocabulary",
        "naturalness",
        "pronunciation",
        "fluency",
        "structure",
        "technical_accuracy",
        "customer_judgment"
      ],
      "title": "FindingCategory",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "category": {
      "$ref": "#/$defs/FindingCategory"
    },
    "evidence": {
