      "type": "integer"
    },
    "source": {
      "enum": [
        "metrics",
        "audit"
      ],
      "title": "Source",
      "type": "string"
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Suggestion"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "id",
    "session_id",
    "category",
    "title",
    "explanation",
    "suggestion",
    "evidence",
    "severity",
    "source"
